# Copia este archivo como .env y rellena los valores. .env NUNCA se sube al repositorio.

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Clave de la API de OpenAI (obligatoria para el asistente). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo (opcional, por defecto gpt-5.4-mini) y esfuerzo de razonamiento (opcional, por defecto low)
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low

# Peticiones al asistente por IP y minuto (opcional, por defecto 10)
LIMITE_IA_POR_MINUTO=10
